# Copy this file to ".env" and change the values.
# NEVER commit your real .env file.
SECRET_KEY=change-this-to-a-long-random-string
FLASK_DEBUG=1
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty to use instance/autocare.db
DATABASE_URL=
# Bookings allowed per date + time slot (1 = one booking per slot)
SLOT_CAPACITY=1
# Sales tax applied to invoices (0.08 = 8%)
TAX_RATE=0.08
# Used ONLY by seed.py to create the first admin
ADMIN_EMAIL=admin@autocare.local
ADMIN_PASSWORD=Admin@12345
